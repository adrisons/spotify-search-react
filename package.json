    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.1.0",
    "jsdom": "^26.1.0",
    "storybook": "^8.6.14",
    "tailwindcss": "^4.1.7",
    "typescript": "^5.8.3",
